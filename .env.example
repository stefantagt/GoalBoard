# Public Neon endpoints only. Never put a Postgres connection string,
# database password, or Neon API key in these variables. Vite inlines them
# into the static site, and the app refuses values that look like secrets.
#
# Copy this file to .env for local development, then restart `npm run dev`.
# In GitHub Actions the same names are repository variables, not secrets,
# because they are visible in the built JavaScript by design.

# Auth base URL from Neon Console → Project → Branch → Auth → Configuration.
VITE_NEON_AUTH_URL=https://ep-example.neonauth.c-2.us-east-1.aws.neon.tech/neondb/auth

# Data API URL from Neon Console → Project → Branch → Data API.
VITE_NEON_DATA_API_URL=https://ep-example.apirest.c-2.us-east-1.aws.neon.tech/neondb/rest/v1

# Optional alternative to the two variables above. The SDK derives the Auth
# and Data API URLs from this credential-free HTTPS database URL.
# Leave it unset when the two URLs above are set.
# VITE_NEON_DATABASE_URL=https://ep-example.c-2.us-east-1.aws.neon.tech/neondb
